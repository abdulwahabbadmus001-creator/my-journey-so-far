# PUBLIC DATE GATE
# Development only. Leave blank/unset in production.
# Allowed values: pre | birthday | post
VITE_PREVIEW_MODE=

# FIREBASE WEB APP
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
