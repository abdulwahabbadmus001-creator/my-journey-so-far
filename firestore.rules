rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if owner();
    }

    match /memories/{memoryId} {
      allow read: if resource.data.published == true || owner();
      allow create, update, delete: if owner();
    }

    match /wishes/{wishId} {
      allow read: if resource.data.status == 'approved' || owner();
      allow create: if request.resource.data.keys().hasOnly(['name','relationship','message','status','featured','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.relationship is string
        && request.resource.data.relationship.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.featured == false;
      allow update, delete: if owner();
    }

    match /guestbook/{entryId} {
      allow read: if resource.data.status == 'approved' || owner();
      allow create: if request.resource.data.keys().hasOnly(['name','note','status','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'pending';
      allow update, delete: if owner();
    }

    match /leads/{leadId} {
      allow read, update, delete: if owner();
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','preferredContact','organisation','projectType','brief','budget','status','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.organisation is string
        && request.resource.data.organisation.size() <= 140
        && request.resource.data.preferredContact in ['Email','WhatsApp','Phone']
        && request.resource.data.projectType is string
        && request.resource.data.projectType.size() <= 100
        && request.resource.data.brief is string
        && request.resource.data.brief.size() >= 10
        && request.resource.data.brief.size() <= 2500
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 80
        && request.resource.data.status == 'new';
    }

    match /timeCapsule/{messageId} {
      allow read, update, delete: if owner();
      allow create: if request.resource.data.keys().hasOnly(['name','message','unlockDate','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1500
        && request.resource.data.unlockDate == '2027-10-30';
    }

    match /letters/{letterId} {
      allow read: if resource.data.published == true || owner();
      allow create, update, delete: if owner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
